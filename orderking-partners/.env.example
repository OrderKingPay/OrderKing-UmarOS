# ── Database ──
DATABASE_URL=postgresql://user:pass@host:5432/orderking_partners
DATABASE_DIRECT_URL=postgresql://user:pass@host:5432/orderking_partners

# ── Auth (better-auth) ──
BETTER_AUTH_SECRET=change-me-to-random-64-char
BETTER_AUTH_URL=https://partner.orderking.app

# ── Push Notifications (FCM - Incoming Order Rings & Kitchen Alerts) ──
FCM_PROJECT_ID=orderking
FCM_PRIVATE_KEY=xxx
FCM_CLIENT_EMAIL=xxx

# ── Payment Gateway (Razorpay Partner Settlements & Payouts) ──
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# ── File Storage (Cloudflare R2 / S3 - Menu Photos, Banners & FSSAI / KYC) ──
S3_BUCKET=orderking-uploads
S3_REGION=auto
S3_ACCESS_KEY=xxx
S3_SECRET_KEY=xxx
S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com

# ── Maps (Restaurant Geolocation & Delivery Radius Geofencing) ──
GOOGLE_MAPS_API_KEY=xxx

# ── SMS (MSG91 - Partner Staff Login & Instant Alerts) ──
MSG91_AUTH_KEY=xxx
MSG91_TEMPLATE_ID=xxx
MSG91_SENDER_ID=ORDKNG

# ── Email (Resend - Merchant Onboarding & Financial Statements) ──
RESEND_API_KEY=re_xxx
RESEND_FROM=noreply@orderking.app

# ── AI / LLM (Menu Description Generator & Business Analytics) ──
GEMINI_API_KEY=xxx
OPENAI_API_KEY=sk-xxx
OPENAI_PARTNER_MODEL=gpt-5.6-terra

# ── Error Tracking ──
SENTRY_DSN=https://xxx@sentry.io/xxx

# ── Inter-Service ──
SERVICE_TOKEN=change-me-to-random-token
ORDERKING_SERVICE_TOKEN=change-me-to-random-token
ORDERKING_SERVICE_USER_ID=partner-service-worker

# ── App ──
NODE_ENV=production
PORT=3000
