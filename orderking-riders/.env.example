# ── Database ──
DATABASE_URL=postgresql://user:pass@host:5432/orderking_riders
DATABASE_DIRECT_URL=postgresql://user:pass@host:5432/orderking_riders

# ── Auth (better-auth) ──
BETTER_AUTH_SECRET=change-me-to-random-64-char
BETTER_AUTH_URL=https://rider.orderking.app

# ── Maps (Google Maps API - Live Navigation, Routing & GPS Telemetry) ──
GOOGLE_MAPS_API_KEY=xxx

# ── Push Notifications (FCM - Urgent Order Dispatch & Broadcast Rings) ──
FCM_PROJECT_ID=orderking
FCM_PRIVATE_KEY=xxx
FCM_CLIENT_EMAIL=xxx

# ── SMS (MSG91 - Rider OTP Login & Shift Verification) ──
MSG91_AUTH_KEY=xxx
MSG91_TEMPLATE_ID=xxx
MSG91_SENDER_ID=ORDKNG

# ── Payment Gateway (Razorpay - Payouts & COD Cash Settlements) ──
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# ── File Storage (Cloudflare R2 / S3 - Driver License, KYC & Delivery Proof) ──
S3_BUCKET=orderking-uploads
S3_REGION=auto
S3_ACCESS_KEY=xxx
S3_SECRET_KEY=xxx
S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com

# ── Email (Resend) ──
RESEND_API_KEY=re_xxx
RESEND_FROM=noreply@orderking.app

# ── AI / LLM (Route Optimization & Rider Support) ──
GEMINI_API_KEY=xxx
OPENAI_API_KEY=sk-xxx

# ── Error Tracking ──
SENTRY_DSN=https://xxx@sentry.io/xxx

# ── Live OrderKing Core Integration ──
HDMASTER_URL=https://hdmaster.vercel.app
ORDERKING_SERVICE_TOKEN=change-me-to-random-token
ORDERKING_SERVICE_USER_ID=rider-service-worker

# ── Inter-Service ──
SERVICE_TOKEN=change-me-to-random-token
ORDERKING_SERVICE_TOKEN=change-me-to-random-token
ORDERKING_SERVICE_USER_ID=rider-service-worker

# ── App ──
NODE_ENV=production
PORT=3000
