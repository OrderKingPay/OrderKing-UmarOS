# ── Database ──
DATABASE_URL=postgresql://user:pass@host:5432/orderking_customers
DATABASE_DIRECT_URL=postgresql://user:pass@host:5432/orderking_customers

# ── Auth (better-auth) ──
BETTER_AUTH_SECRET=change-me-to-random-64-char
BETTER_AUTH_URL=https://customer.orderking.app

# ── Payment Gateway (Razorpay Checkout & Webhooks) ──
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# ── Maps (Address Autocomplete, Geocoding & Order Tracking) ──
GOOGLE_MAPS_API_KEY=xxx

# ── SMS (MSG91 - Customer OTP & Order Alerts) ──
MSG91_AUTH_KEY=xxx
MSG91_TEMPLATE_ID=xxx
MSG91_SENDER_ID=ORDKNG

# ── Push Notifications (FCM - Order Milestones & Live Status) ──
FCM_PROJECT_ID=orderking
FCM_PRIVATE_KEY=xxx
FCM_CLIENT_EMAIL=xxx

# ── Email (Resend - Invoices & Receipts) ──
RESEND_API_KEY=re_xxx
RESEND_FROM=noreply@orderking.app

# ── File Storage (Cloudflare R2 / S3 - User Avatars & Media) ──
S3_BUCKET=orderking-uploads
S3_REGION=auto
S3_ACCESS_KEY=xxx
S3_SECRET_KEY=xxx
S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com

# ── AI / LLM (Customer Recommendations & Voice Assistant) ──
GEMINI_API_KEY=xxx
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
XAI_API_KEY=xai-xxx

# ── Error Tracking ──
SENTRY_DSN=https://xxx@sentry.io/xxx

# ── Inter-Service ──
SERVICE_TOKEN=change-me-to-random-token
ORDERKING_SERVICE_TOKEN=change-me-to-random-token
ORDERKING_SERVICE_USER_ID=customer-service-worker

# ── App ──
NODE_ENV=production
PORT=3000
