# ===============================================================================
# ORDERKING CENTRAL ADMIN & COMMAND PLATFORM (HDMASTER) - ENVIRONMENT TEMPLATE
# ===============================================================================
# Standardized classification: [SECRET] vs [TEXT]
# Cloudflare Pages: [SECRET] -> Encrypted Secret (wrangler pages secret put)
#                   [TEXT]   -> Plaintext Environment Variable
# Vercel:           [SECRET] -> Sensitive Environment Variable
#                   [TEXT]   -> Plain Environment Variable
# ===============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. CORE DATABASE & AUTHENTICATION
# ─────────────────────────────────────────────────────────────────────────────
# [SECRET] PostgreSQL / Supabase connection pooling string
DATABASE_URL=postgresql://user:password@host:6543/postgres

# [SECRET] Direct connection string (for migrations / schema push)
DATABASE_DIRECT_URL=postgresql://user:password@host:5432/postgres

# [SECRET] Cryptographic secret used by Better-Auth to sign session tokens (64 hex characters)
BETTER_AUTH_SECRET=change-me-to-random-64-character-secret

# [TEXT] Public base URL of this application
BETTER_AUTH_URL=https://admin.orderkingpay.com

# [TEXT] Grok platform workspace / project identifier
GROK_PROJECT_ID=1809652e-8dad-44ba-8bfa-67bafbfb2dfd

# [TEXT] Build flag enabling authentication runtime
VITE_AUTH_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# 2. FOUNDER ZERO-FEE DIRECT NPCI UPI VPAS (Treasury & Sovereign Operations)
# ─────────────────────────────────────────────────────────────────────────────
# [TEXT] Founder's PhonePe UPI VPA
FOUNDER_UPI_PHONEPE=9395065587@ybl

# [TEXT] Founder's Paytm UPI VPA
FOUNDER_UPI_PAYTM=9395065587@pthdfc

# [TEXT] Founder's CRED UPI VPA
FOUNDER_UPI_CRED=9395065587@yescred

# [TEXT] Founder's BHIM UPI VPA
FOUNDER_UPI_BHIM=9395065587@upi

# [TEXT] Founder's Amazon Pay UPI VPA
FOUNDER_UPI_AMAZONPAY=9395065587@apl

# [TEXT] Primary universal / fallback founder UPI ID
FOUNDER_UPI_ID=9395065587@ybl

# [TEXT] Primary universal / fallback founder VPA
FOUNDER_UPI_VPA=9395065587@ybl

# ─────────────────────────────────────────────────────────────────────────────
# 3. COMMERCIAL PAYMENT GATEWAY (Razorpay)
# ─────────────────────────────────────────────────────────────────────────────
# [TEXT] Razorpay Public Key ID
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx

# [SECRET] Razorpay Secret Key (Full ledger access & master reconciliation)
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# [SECRET] Razorpay Webhook Secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# [TEXT] Razorpay Merchant Account ID
RAZORPAY_MERCHANT_ACCOUNT_ID=your_merchant_account_id

# ─────────────────────────────────────────────────────────────────────────────
# 4. ARTIFICIAL INTELLIGENCE & LLM ORCHESTRATION (Universal Superintelligence)
# ─────────────────────────────────────────────────────────────────────────────
# [SECRET] Google Gemini API Key (Frontier multimodal model, auto-repair, code-engine, health-monitor)
GEMINI_API_KEY=your_gemini_api_key_here

# [SECRET] OpenAI API Key (GPT-4o, embeddings, consensus engine)
OPENAI_API_KEY=your_openai_api_key_here

# [SECRET] Anthropic API Key (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# [SECRET] xAI Grok API Key
XAI_API_KEY=your_xai_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# 5. COMMUNICATIONS & NOTIFICATIONS
# ─────────────────────────────────────────────────────────────────────────────
# [SECRET] MSG91 SMS Gateway authentication key
MSG91_AUTH_KEY=your_msg91_auth_key_here

# [TEXT] MSG91 DLT approved OTP template ID
MSG91_TEMPLATE_ID=your_msg91_template_id_here

# [TEXT] MSG91 approved 6-character sender ID
MSG91_SENDER_ID=ORDKNG

# [TEXT] Firebase Cloud Messaging project ID
FCM_PROJECT_ID=orderking-prod

# [SECRET] Firebase service account private key
FCM_PRIVATE_KEY="your_fcm_private_key_here"

# [TEXT] Firebase service account client email
FCM_CLIENT_EMAIL=firebase-adminsdk@orderking-prod.iam.gserviceaccount.com

# [SECRET] Resend transactional email API key
RESEND_API_KEY=re_your_resend_api_key_here

# [TEXT] Resend verified sender email address
RESEND_FROM=admin@orderkingpay.com

# ─────────────────────────────────────────────────────────────────────────────
# 6. MAPS & GEOLOCATION
# ─────────────────────────────────────────────────────────────────────────────
# [SECRET] Google Maps API key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# 7. INTER-SERVICE REVENUE & DISPATCH GOVERNANCE
# ─────────────────────────────────────────────────────────────────────────────
# [SECRET] Master inter-service governance tokens
SERVICE_TOKEN=your_service_token_here
ORDERKING_SERVICE_TOKEN=your_orderking_service_token_here

# [TEXT] Master system admin user ID
ORDERKING_SERVICE_USER_ID=master-system-admin

# ─────────────────────────────────────────────────────────────────────────────
# 8. RUNTIME & PLATFORM URLS
# ─────────────────────────────────────────────────────────────────────────────
# [TEXT] Application URLs across the ecosystem
CUSTOMER_APP_URL=https://orderkingpay.com
PARTNER_APP_URL=https://partner.orderkingpay.com
RIDER_APP_URL=https://rider.orderkingpay.com
ADMIN_APP_URL=https://admin.orderkingpay.com
API_GATEWAY_URL=https://admin.orderkingpay.com/api

# [TEXT] Node runtime environment & port
NODE_ENV=production
PORT=3000
