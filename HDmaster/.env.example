# ── Database ──
DATABASE_URL=postgresql://user:pass@host:5432/orderking_hdmaster
DATABASE_DIRECT_URL=postgresql://user:pass@host:5432/orderking_hdmaster

# ── Auth (better-auth) ──
BETTER_AUTH_SECRET=change-me-to-random-64-char
BETTER_AUTH_URL=https://admin.orderking.app

# ── AI / LLM (Master AI Orchestration) ──
GEMINI_API_KEY=xxx
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
XAI_API_KEY=xai-xxx

# ── Inter-Service Authentication & Governance ──
SERVICE_TOKEN=change-me-to-random-token
ORDERKING_SERVICE_TOKEN=change-me-to-random-token
ORDERKING_SERVICE_USER_ID=master-system-admin

# ── GitHub Integration (Engineering Read Adapter) ──
GITHUB_TOKEN=ghp_xxx
GITHUB_OWNER=Foodpalace

# ── Payment Gateway ──
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# ── SMS (MSG91) ──
MSG91_AUTH_KEY=xxx
MSG91_TEMPLATE_ID=xxx
MSG91_SENDER_ID=ORDKNG

# ── Push Notifications ──
FCM_PROJECT_ID=orderking
FCM_PRIVATE_KEY=xxx
FCM_CLIENT_EMAIL=xxx

# ── Email (Resend) ──
RESEND_API_KEY=re_xxx
RESEND_FROM=noreply@orderking.app

# ── File Storage (Cloudflare R2 / S3) ──
S3_BUCKET=orderking-uploads
S3_REGION=auto
S3_ACCESS_KEY=xxx
S3_SECRET_KEY=xxx
S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com

# ── Maps ──
GOOGLE_MAPS_API_KEY=xxx

# ── Error Tracking ──
SENTRY_DSN=https://xxx@sentry.io/xxx

# ── App ──
NODE_ENV=production
PORT=3000

# ── Secure production diagnostic access ──
UMAR_OS_ADMIN_TOKEN=replace-with-a-strong-random-secret
