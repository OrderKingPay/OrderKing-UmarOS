# Cloudflare Pages Global Edge Caching & Security Headers
# OrderKing Platform: orderking-customers

# 1. Global Security Headers (Universal)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-XSS-Protection: 1; mode=block
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://checkout.razorpay.com https://challenges.cloudflare.com https://tpwidg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-src 'self' https://checkout.razorpay.com https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self' https:;

# 2. Critical Dynamic Metadata & Uncached HTML Shells
/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: application/manifest+json; charset=utf-8

# 3. Immutable Long-Term Static Assets (Hashed bundles)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 4. Media & Static Assets
/food/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/brand/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/__grok/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icon-192.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icon-512.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/logo.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/og.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/offline.html
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/robots.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

/sitemap.xml
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
