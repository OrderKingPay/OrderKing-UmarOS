# ===============================================================================
# ORDERKING UMAROS MONOREPO - ENVIRONMENT SPECIFICATION TEMPLATE
# ===============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase / Direct Pooler)
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/orderking
DATABASE_DIRECT_URL=postgresql://user:password@localhost:5432/orderking
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─────────────────────────────────────────────────────────────────────────────
# 2. COMMERCIAL MONETIZATION: RAZORPAY GATEWAY (India UPI, Cards & Payouts)
# ─────────────────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_MERCHANT_ACCOUNT_ID=your_merchant_account_id

# ─────────────────────────────────────────────────────────────────────────────
# 3. COMMERCIAL MONETIZATION: STRIPE GATEWAY (Global USD, SaaS & Connect)
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# ─────────────────────────────────────────────────────────────────────────────
# 4. AUTHENTICATION & SESSION ISOLATION (Better Auth)
# ─────────────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=https://orderking.app

# ─────────────────────────────────────────────────────────────────────────────
# 5. INTER-SERVICE REVENUE & DISPATCH GOVERNANCE
# ─────────────────────────────────────────────────────────────────────────────
SERVICE_TOKEN=your_service_token_here
ORDERKING_SERVICE_TOKEN=your_orderking_service_token_here
ORDERKING_SERVICE_USER_ID=master-system-admin

# ─────────────────────────────────────────────────────────────────────────────
# 6. EXTERNAL COMMUNICATIONS (SMS, Push Notifications, Email)
# ─────────────────────────────────────────────────────────────────────────────
MSG91_AUTH_KEY=your_msg91_key_here
MSG91_TEMPLATE_ID=your_msg91_template_here
MSG91_SENDER_ID=ORDKNG
SMS_PROVIDER=MSG91

FCM_PROJECT_ID=orderking-prod
FCM_PRIVATE_KEY="your_fcm_private_key_here"
FCM_CLIENT_EMAIL=firebase-adminsdk@orderking-prod.iam.gserviceaccount.com

RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=receipts@orderking.app

# ─────────────────────────────────────────────────────────────────────────────
# 7. MAPS & GEOLOCATION (Google Maps / Mapbox)
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
MAPS_PROVIDER=GOOGLE

# ─────────────────────────────────────────────────────────────────────────────
# 8. STATUTORY & INSTITUTIONAL COMPLIANCE (India MCA / GSTN / FSSAI)
# ─────────────────────────────────────────────────────────────────────────────
LEGAL_ENTITY_NAME="OrderKing Technologies Private Limited"
LEGAL_GSTIN=29AABCU9603R1ZM
LEGAL_FSSAI=10019043002678
LEGAL_PAN=AABCU9603R
LEGAL_TAN=BLRU01234F
LEGAL_BANK_ACCOUNT_HOLDER="OrderKing Technologies Private Limited"
LEGAL_BANK_NAME="HDFC Bank Limited"
LEGAL_BANK_ACCOUNT_NUMBER=50200000000000
LEGAL_BANK_IFSC=HDFC0000001
LEGAL_UPI_VPA=orderking@hdfcbank

# ─────────────────────────────────────────────────────────────────────────────
# 9. RUNTIME & DEPLOYMENT TARGETS
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
CUSTOMER_APP_URL=https://customer.orderking.app
PARTNER_APP_URL=https://partner.orderking.app
RIDER_APP_URL=https://rider.orderking.app
ADMIN_APP_URL=https://admin.orderking.app
API_GATEWAY_URL=https://api.orderking.app
