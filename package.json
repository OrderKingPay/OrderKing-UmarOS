{
  "name": "orderking-quadcore",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "deploy:cloudrun": "powershell -ExecutionPolicy Bypass -File scripts/deploy-cloudrun.ps1",
    "verify:cloudflare": "node scripts/verify-cloudflare-only.mjs",
    "verify:payments": "node scripts/verify-payment-key-safety.mjs",
    "verify:production": "pnpm run verify:cloudflare && pnpm run verify:payments && pnpm run verify:secrets",
    "verify:secrets": "node scripts/verify-secret-hygiene.mjs"
  },
  "devDependencies": {
    "turbo": "latest"
  }
}
