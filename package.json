{
    "name": "orderking-quadcore",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@9.15.4",
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "typecheck": "turbo run typecheck",
        "deploy": "powershell -ExecutionPolicy Bypass -File .\\deploy.ps1 -Action deploy",
        "deploy:customers": "pnpm --filter orderking-customers run deploy",
        "deploy:partners": "pnpm --filter orderking-partners run deploy",
        "deploy:riders": "pnpm --filter orderking-riders run deploy",
        "deploy:admin": "pnpm --filter HDmaster run deploy"
    },
    "devDependencies": {
        "turbo": "latest",
        "wrangler": "^4.152.0"
    },
    "dependencies": {
        "@google/genai": "^2.27.0",
        "axios": "^1.20.0",
        "dotenv": "^16.4.5"
    },
    "resolutions": {
        "nanostores": "1.5.4"
    }
}
