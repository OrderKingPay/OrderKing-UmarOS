# ── Database ──
DATABASE_URL=postgresql://user:pass@host:5432/orderking_integration
DATABASE_DIRECT_URL=postgresql://user:pass@host:5432/orderking_integration

# ── Auth (better-auth) ──
BETTER_AUTH_SECRET=change-me-to-random-64-char
BETTER_AUTH_URL=https://integration.orderking.app

# ── Inter-Service (Cross-Repo Authentication & Webhook Tokens) ──
SERVICE_TOKEN=change-me-to-random-token
ORDERKING_SERVICE_TOKEN=change-me-to-random-token
ORDERKING_SERVICE_USER_ID=integration-service-worker

# ── Payment Gateway (Razorpay Webhook & Payment Sync) ──
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# ── SMS (MSG91 - Global SMS Gateway Integration) ──
MSG91_AUTH_KEY=xxx
MSG91_TEMPLATE_ID=xxx
MSG91_SENDER_ID=ORDKNG

# ── Push Notifications (FCM - Dispatch Events & Broadcast Relays) ──
FCM_PROJECT_ID=orderking
FCM_PRIVATE_KEY=xxx
FCM_CLIENT_EMAIL=xxx

# ── Email (Resend - Notification Engine) ──
RESEND_API_KEY=re_xxx
RESEND_FROM=noreply@orderking.app

# ── File Storage (Cloudflare R2 / S3 - Shared Media Asset Storage) ──
S3_BUCKET=orderking-uploads
S3_REGION=auto
S3_ACCESS_KEY=xxx
S3_SECRET_KEY=xxx
S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com

# ── Maps ──
GOOGLE_MAPS_API_KEY=xxx

# ── AI / LLM ──
GEMINI_API_KEY=xxx
OPENAI_API_KEY=sk-xxx

# ── Error Tracking ──
SENTRY_DSN=https://xxx@sentry.io/xxx

# ── App ──
NODE_ENV=production
PORT=3000
